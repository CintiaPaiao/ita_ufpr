[app]
env = "production"
demo_mode = false

[database]
# Recomendado para Streamlit em produção: PostgreSQL externo persistente.
# Exemplo: postgresql+psycopg://usuario:senha@host:5432/banco?sslmode=require
url = "sqlite:///database/pae.db"

[auth]
session_timeout_minutes = 120
max_login_attempts = 5

# Gere o hash com: python scripts/hash_password.py "SUA_SENHA"
[[auth.users]]
username = "admin"
display_name = "Administrador PAE"
role = "ADMIN"
password_hash = "SUBSTITUA_PELO_HASH_PBKDF2"

[[auth.users]]
username = "profissional1"
display_name = "Profissional 1"
role = "PROFISSIONAL"
password_hash = "SUBSTITUA_PELO_HASH_PBKDF2"
